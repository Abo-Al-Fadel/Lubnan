# ── Frontend ────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
next-env.d.ts
.vercel
*.tsbuildinfo

# Playwright capture output. Regenerated by web/scripts/, never reviewed as
# source, and a screenshot in a diff is noise nobody can read.
crawl/
routes/
verify/
shots*/
spot/
ref/

# Hero video.
#
# A1.mp4 is 584MB and A3.mp4 is 493MB, both far past GitHub's 100MB hard limit
# per file, so they cannot be committed to a normal repository at all. The hero
# degrades correctly without them: PhotoField layers the video over the still
# and only reveals it once it can play, so with no file present the photograph
# simply stays. Drop the mp4s back into web/public/vid/ locally and the motion
# returns with no code change.
web/public/vid/*.mp4

# ── Backend ─────────────────────────────────────────────────────────────────
#
# Note what is NOT ignored: server/src/**/Persistence/Migrations. Migrations are
# source. They are the only record of how the schema got from one shape to the
# next, and a schema rebuilt from the model instead of replayed from migrations
# loses every data transformation along the way.
server/**/bin/
server/**/obj/
server/.vs/
server/**/*.user

# ── Everywhere ──────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
.env
.env*.local
